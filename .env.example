# ============================================================================
#  ENTHEOS WIKI - Configuracion
#
#  El instalador automatico (INSTALAR.bat) copia este archivo como .env y le
#  pone un SESION_SECRETO aleatorio. Se puede arrancar sin tocar nada mas.
#
#  El archivo .env NO se sube al repositorio. Esta en el .gitignore.
# ============================================================================

# Servidor
PUERTO=80
ENTORNO=desarrollo

# Base de datos MySQL.
# INSTALAR.bat te pide la contrasena del usuario root de tu MySQL y la deja
# escrita aca (con BD_USUARIO=root). Los valores de abajo son un ejemplo
# por defecto; se pueden editar a mano con otro usuario o contrasena.
BD_HOST=127.0.0.1
BD_PUERTO=3306
BD_USUARIO=root
BD_CONTRASENA=Kendry9922
BD_NOMBRE=entheos
BD_CONEXIONES=10

# Sesion. INSTALAR.bat genera un valor aleatorio; para cambiarlo a mano:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESION_SECRETO=cambia_este_valor_por_uno_aleatorio
SESION_MINUTOS=120

# Correo (Gmail). Es opcional: solo para el envio real de correo.
# Ver el paso 5 de INSTALAR-OTRA-PC.txt para la contrasena de aplicacion.
GMAIL_USUARIO=tu_correo@gmail.com
GMAIL_CONTRASENA=la_contrasena_de_aplicacion_de_16_caracteres
GMAIL_DESDE="Entheos Wiki <tu_correo@gmail.com>"

# Edge, usado por puppeteer-core para generar los PDF.
# En Windows normalmente es esta ruta. En Mac o Linux hay que cambiarla.
EDGE=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# Cantidad de articulos por pagina en el listado
ARTICULOS_PAGINA=12

# HTTPS local. Opcional: si HTTPS_PFX queda vacio, el servidor solo usa HTTP.
#
# Por defecto el proyecto abre en http://entheoswiki.localhost (el instalador
# agrega el dominio al archivo hosts de Windows). Para activar HTTPS hacen
# falta dos cosas en la computadora:
#   1. La linea "127.0.0.1 entheoswiki.localhost" en el archivo hosts.
#   2. El certificado. Se genera con:
#        powershell -ExecutionPolicy Bypass -File ".\servidor\herramientas\certificado.ps1"
#      Ese script imprime la clave que hay que poner en HTTPS_CLAVE.
#
# Ver INSTALAR-OTRA-PC.txt, paso 7.
HTTPS_PFX=certificados/entheoswiki.pfx
HTTPS_CLAVE=pegar_aqui_la_clave_que_imprimio_el_script
