<%- include('parciales/cabecera') %>

<section class="bloque">
  <div class="bloque-cabecera">
    <h1 class="bloque-titulo">Artículos</h1>
    <% if (esEditor) { %>
      <a href="/panel/articulos/nuevo" class="boton boton-dorado">Nuevo artículo</a>
    <% } %>
  </div>

  <h2 class="bloque-titulo"><%= categoriaActual ? categoriaNombre || 'Artículos' : 'Últimos artículos' %></h2>

  <% if (articulos.length === 0) { %>
    <p class="vacio">No hay artículos todavía.</p>
  <% } else { %>
    <div class="rejilla">
      <% articulos.forEach(function (articulo) {
           const clases = ['tarjeta'];
           if (articulo.categoria === 'Personajes' || articulo.categoria === 'Objetos') clases.push('tarjeta--retrato');
           else if (articulo.categoria === 'Razas') clases.push('tarjeta--raza');
      %>
        <a class="<%= clases.join(' ') %>" href="/articulos/<%= articulo.slug %>">
          <% if (articulo.imagen_ruta) { %>
            <img class="tarjeta-imagen" src="<%= articulo.imagen_ruta %>" alt="" loading="lazy">
          <% } %>
          <span class="tarjeta-cont">
            <% if (articulo.estado !== 'publicado') { %>
              <span class="tarjeta-cabecera">
                <span class="estado estado-<%= articulo.estado %>"><%= etiquetas.estado(articulo.estado) %></span>
              </span>
            <% } %>
            <span class="tarjeta-titulo"><%= articulo.titulo %><% if (articulo.esSubraza && !/^plantilla/i.test(articulo.titulo)) { %><span class="sello-subraza">Subraza</span><% } %></span>
            <span class="tarjeta-resumen"><%= articulo.resumen || 'Sin resumen.' %></span>
            <span class="tarjeta-pie">por <%= articulo.autor_nombre || articulo.autor %></span>
          </span>
        </a>
      <% }); %>
    </div>

    <% if (paginas > 1) { %>
      <nav class="paginacion" aria-label="Páginas">
        <% for (let n = 1; n <= paginas; n++) { %>
          <% if (n === pagina) { %>
            <span class="paginacion-pagina activa"><%= n %></span>
          <% } else { %>
            <a class="paginacion-pagina"
               href="/articulos?pagina=<%= n %><%= categoriaActual ? '&categoria=' + categoriaActual : '' %>"><%= n %></a>
          <% } %>
        <% } %>
      </nav>
    <% } %>
  <% } %>
</section>

<section class="bloque">
  <h2 class="bloque-titulo">Explorar por categoría</h2>
  <div class="botones-categorias">
    <% categorias.forEach(function (categoria) { %>
      <a class="boton-categoria<%= categoriaActual === categoria.id ? ' activa' : '' %>"
         href="/articulos?categoria=<%= categoria.id %>">
        <%= categoria.nombre %>
        <span class="boton-categoria-conteo"><%= categoria.articulos %></span>
      </a>
    <% }); %>
    <% if (categoriaActual) { %>
      <a class="boton-categoria" href="/articulos">Todos los artículos</a>
    <% } %>
  </div>
</section>

<%- include('parciales/pie') %>