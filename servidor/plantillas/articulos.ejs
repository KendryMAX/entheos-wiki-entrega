<%- include('parciales/cabecera') %>

<section class="bloque">
  <div class="bloque-cabecera">
    <h1 class="bloque-titulo">Artículos</h1>
    <% if (esEditor) { %>
      <a href="/panel/articulos/nuevo" class="boton boton-dorado">Nuevo artículo</a>
    <% } %>
  </div>

  <div class="filtros">
    <span class="filtros-etiqueta">Categorías:</span>
    <% categorias.forEach(function (categoria) { %>
      <a class="ficha <%= categoriaActual === categoria.id ? 'activa' : '' %>"
         href="/articulos?categoria=<%= categoria.id %>">
        <%= categoria.nombre %> <span class="ficha-conteo"><%= categoria.articulos %></span>
      </a>
    <% }); %>
  </div>

  <p class="resultados"><%= total %> artículo<%= total === 1 ? '' : 's' %> encontrado<%= total === 1 ? '' : 's' %>.</p>

  <% if (articulos.length === 0) { %>
    <p class="vacio">No hay artículos todavía.</p>
  <% } else { %>
    <div class="rejilla">
      <% articulos.forEach(function (articulo) { %>
        <a class="tarjeta<%= articulo.categoria === 'Personajes' ? ' tarjeta--retrato' : '' %>" href="/articulos/<%= articulo.slug %>">
          <% if (articulo.imagen_ruta) { %>
            <img class="tarjeta-imagen" src="<%= articulo.imagen_ruta %>" alt="" loading="lazy">
          <% } %>
          <span class="tarjeta-cont">
            <span class="tarjeta-cabecera">
              <% if (articulo.estado !== 'publicado') { %>
                <span class="estado estado-<%= articulo.estado %>"><%= articulo.estado.replace('_', ' ') %></span>
              <% } %>
              <% if (articulo.categoria) { %>
                <span class="tarjeta-categoria"><%= articulo.categoria %></span>
              <% } %>
            </span>
            <span class="tarjeta-titulo"><%= articulo.titulo %></span>
            <span class="tarjeta-resumen"><%= articulo.resumen || 'Sin resumen.' %></span>
            <span class="tarjeta-pie">
              por <%= articulo.autor %> &middot; <%= articulo.vistas %> vista<%= articulo.vistas === 1 ? '' : 's' %>
              <% if (articulo.comentarios > 0) { %>
                &middot; <%= articulo.comentarios %> comentario<%= articulo.comentarios === 1 ? '' : 's' %>
              <% } %>
            </span>
          </span>
        </a>
      <% }); %>
    </div>

    <% if (paginas > 1) { %>
      <nav class="paginacion" aria-label="Páginas">
        <% for (let n = 1; n <= paginas; n++) { %>
          <% if (n === pagina) { %>
            <span class="paginacion-pagina activa"><%= n %></span>
          <% } else { %>
            <a class="paginacion-pagina"
               href="/articulos?pagina=<%= n %><%= categoriaActual ? '&categoria=' + categoriaActual : '' %>"><%= n %></a>
          <% } %>
        <% } %>
      </nav>
    <% } %>
  <% } %>
</section>

<%- include('parciales/pie') %>