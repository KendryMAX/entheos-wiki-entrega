<%- include('../parciales/cabecera') %>

<section class="hoja hoja-error">
  <p class="error-codigo">403</p>
  <h1 class="hoja-titulo">No tienes permiso</h1>
  <p class="error-texto">
    <%= typeof mensaje !== 'undefined' && mensaje ? mensaje : 'Tu rol no alcanza para ver esta página. Si creés que es un error, pedile al Administrador que te cambie el rol.' %>
  </p>
  <p class="error-ruta"><code><%= ruta %></code></p>
  <p>
    <a href="/" class="boton boton-dorado">Volver al inicio</a>
    <a href="/salir" class="boton boton-plano">Cambiar de cuenta</a>
  </p>
</section>

<%- include('../parciales/pie') %>