<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> · Entheos Wiki</title>
  <meta name="description" content="Wiki de consulta sobre el mundo de Entheos: lugares, personajes, objetos y cronologia.">
  <link rel="stylesheet" href="/estilos/estilos.css">
  <link rel="icon" href="/imagenes/icono.svg" type="image/svg+xml">
</head>
<body>

<header class="barra-superior">
  <div class="barra-interior">

    <a class="marca" href="/">
      <span class="marca-simbolo" aria-hidden="true">&#9670;</span>
      <span class="marca-texto">Entheos <em>Wiki</em></span>
    </a>

    <button class="boton-menu" type="button" aria-expanded="false" aria-controls="navegacion-principal" aria-label="Abrir el menu">
      <span></span><span></span><span></span>
    </button>

    <nav class="navegacion" id="navegacion-principal" aria-label="Navegacion principal">
      <ul>
        <li><a href="/" class="<%= rutaActual === '/' ? 'activo' : '' %>">Inicio</a></li>
        <li><a href="/articulos" class="<%= rutaActual.startsWith('/articulos') ? 'activo' : '' %>">Articulos</a></li>
        <li><a href="/personajes" class="<%= rutaActual === '/personajes' ? 'activo' : '' %>">Personajes</a></li>
        <li><a href="/lugares" class="<%= rutaActual === '/lugares' ? 'activo' : '' %>">Lugares</a></li>
        <li><a href="/cronologia" class="<%= rutaActual === '/cronologia' ? 'activo' : '' %>">Cronologia</a></li>

        <% if (esEditor) { %>
          <li class="separador" aria-hidden="true"></li>
          <li><a href="/panel/articulos" class="<%= rutaActual.startsWith('/panel/articulos') ? 'activo' : '' %>">Mis articulos</a></li>
          <li><a href="/panel/revision" class="<%= rutaActual === '/panel/revision' ? 'activo' : '' %>">Revision</a></li>
          <li><a href="/panel/comentarios" class="<%= rutaActual === '/panel/comentarios' ? 'activo' : '' %>">Comentarios</a></li>
        <% } %>

        <% if (esAdministrador) { %>
          <li><a href="/panel/usuarios" class="<%= rutaActual === '/panel/usuarios' ? 'activo' : '' %>">Usuarios</a></li>
        <% } %>
      </ul>

      <form class="buscador" action="/buscar" method="GET" role="search">
        <label class="solo-lectores" for="q-barra">Buscar</label>
        <input type="search" id="q-barra" name="q" placeholder="Buscar en la wiki..."
               autocomplete="off" data-autocompletado>
        <ul class="sugerencias" data-sugerencias hidden></ul>
      </form>
    </nav>

    <div class="sesion">
      <% if (usuario) { %>
        <span class="insignia-rol insignia-rol-<%= nivel %>"><%= rol %></span>
        <span class="nombre-usuario" title="<%= usuario.email %>"><%= usuario.nombre_usuario %></span>
        <form action="/salir" method="POST" class="formulario-salir">
          <button type="submit" class="boton boton-plano">Salir</button>
        </form>
      <% } else { %>
        <a href="/acceso" class="boton boton-plano">Ingresar</a>
        <a href="/registro" class="boton boton-dorado">Crear cuenta</a>
      <% } %>
    </div>

  </div>
</header>

<main class="contenido">