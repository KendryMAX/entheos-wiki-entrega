<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> · Entheos Wiki</title>
  <meta name="description" content="Wiki de consulta sobre el mundo de Entheos: continentes, lugares, personajes y objetos.">
  <link rel="stylesheet" href="/estilos/estilos.css">
  <link rel="icon" href="/imagenes/icono.svg" type="image/svg+xml">
</head>
<body class="<%= (rutaActual === '/acceso' || rutaActual === '/registro' || locals.paginaAuth) ? 'pagina-auth' : '' %>">

<a class="saltar" href="#contenido-principal">Saltar al contenido</a>

<header class="barra-superior">
  <div class="barra-interior">

    <a class="marca" href="/">
      <span class="marca-simbolo" aria-hidden="true">&#9670;</span>
      <span class="marca-texto"><span class="marca-nombre">Entheos</span> <em>Wiki</em></span>
    </a>

    <nav class="navegacion" aria-label="Navegación principal">
      <%
        const accesos = [
          { href: '/', texto: 'Inicio', activo: rutaActual === '/' },
          { href: '/articulos', texto: 'Artículos', activo: rutaActual.startsWith('/articulos') },
          { href: '/comunidad', texto: 'Comunidad', activo: rutaActual.startsWith('/comunidad') },
          { href: '/reportes', texto: 'Reportes', activo: rutaActual === '/reportes' },
        ];
        const anchoTri = 100;
        const angulo = Math.PI / accesos.length;
        const radio = Math.round(anchoTri / (2 * Math.sin(angulo / 2)));
        const altoTri = radio;
      %>

      <div class="accesos-rapidos">
        <button class="accesos-boton" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="navegacion-principal" aria-label="Abrir accesos rápidos">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2.2l.85 1.75 1.9.28-1.38 1.35.33 1.9L12 6.58l-1.7.9.33-1.9L9.25 4.23l1.9-.28z" fill="currentColor" stroke="none"/>
            <path d="M4.8 3.4l.44.9 1 .14-.72.7.17 1-.89-.47-.89.47.17-1-.72-.7 1-.14z" fill="currentColor" stroke="none"/>
            <path d="M19.2 3.4l.44.9 1 .14-.72.7.17 1-.89-.47-.89.47.17-1-.72-.7 1-.14z" fill="currentColor" stroke="none"/>
            <path d="M12 8.4v10.9"/>
            <path d="M12 8.4C10.1 7 7.6 7 5 8.3v10.8C7.6 17.8 10.1 17.8 12 19.2"/>
            <path d="M12 8.4c1.9-1.4 4.4-1.4 7-.1v10.8c-2.6-1.3-5.1-1.3-7 .1"/>
          </svg>
        </button>

        <ul class="medialuna" id="navegacion-principal" style="--tri-ancho: <%= anchoTri %>px; --tri-alto: <%= altoTri %>px;">
          <% accesos.forEach(function (acceso, indice) {
               const grados = 180 - (indice + 0.5) * (180 / accesos.length);
               const rot = Math.round(grados - 90);
          %>
            <li style="--rot: <%= rot %>deg;" data-rot="<%= rot %>">
              <a href="<%= acceso.href %>" class="opcion<%= acceso.activo ? ' activo' : '' %>"><span class="opcion-texto"><%= acceso.texto %></span></a>
            </li>
          <% }); %>
        </ul>
      </div>
    </nav>

    <div class="sesion">
      <% if (usuario) { %>
        <% if (esEditor) { %>
          <a class="sesion-panel" href="/panel/articulos">Panel</a>
        <% } %>
        <span class="insignia-rol insignia-rol-<%= nivel %>"><%= rol %></span>
        <span class="nombre-usuario" title="<%= usuario.email %>"><%= usuario.nombre_usuario %></span>
        <form action="/salir" method="POST" class="formulario-salir">
          <button type="submit" class="boton boton-plano boton-chico">Salir</button>
        </form>
      <% } else { %>
        <a href="/acceso" class="sesion-link">Ingresar</a>
        <a href="/registro" class="sesion-cta">Crear cuenta</a>
      <% } %>
    </div>

  </div>
</header>

<div class="marco">

<aside class="contadores" aria-label="Cantidad de contenido">
  <ul>
    <li><span class="contador-anillo"><span class="contador-numero"><%= conteos.articulo %></span><span class="contador-texto">Artículos</span></span></li>
    <li><span class="contador-anillo"><span class="contador-numero"><%= conteos.usuario %></span><span class="contador-texto">Usuarios</span></span></li>
    <li><span class="contador-anillo"><span class="contador-numero"><%= conteos.comentario %></span><span class="contador-texto">Comentarios</span></span></li>
    <li><span class="contador-anillo"><span class="contador-numero"><%= conteos.mensaje_comunidad %></span><span class="contador-texto">Mensajes en la Comunidad</span></span></li>
  </ul>
</aside>

<main class="contenido" id="contenido-principal">