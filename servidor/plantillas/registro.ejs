<%- include('parciales/cabecera') %>

<section class="hoja">
  <h1 class="hoja-titulo">Crear cuenta</h1>

  <% if (error) { %>
    <p class="alerta alerta-error"><%= error %></p>
  <% } %>

  <form class="formulario" action="/registro" method="POST" novalidate data-validar>

    <div class="campo">
      <label for="nombre_usuario">Nombre de usuario</label>
      <input type="text" id="nombre_usuario" name="nombre_usuario"
             value="<%= datos.nombre_usuario || '' %>" required
             pattern="[a-zA-Z0-9_.\-]{3,50}"
             data-error="Entre 3 y 50 caracteres: letras, numeros, punto, guion o guion bajo."
             autocomplete="username">
      <span class="campo-error" data-error-de="nombre_usuario"></span>
    </div>

    <div class="campo">
      <label for="nombre_completo">Nombre completo</label>
      <input type="text" id="nombre_completo" name="nombre_completo"
             value="<%= datos.nombre_completo || '' %>" required minlength="3"
             data-error="Escribi tu nombre completo."
             autocomplete="name">
      <span class="campo-error" data-error-de="nombre_completo"></span>
    </div>

    <div class="campo">
      <label for="email">Correo</label>
      <input type="email" id="email" name="email"
             value="<%= datos.email || '' %>" required
             data-error="Ese correo no tiene un formato valido."
             autocomplete="email">
      <span class="campo-error" data-error-de="email"></span>
    </div>

    <div class="campo">
      <label for="contrasena">Contrasena</label>
      <input type="password" id="contrasena" name="contrasena" required minlength="8"
             data-error="La contrasena necesita al menos 8 caracteres."
             autocomplete="new-password">
      <span class="campo-error" data-error-de="contrasena"></span>
      <span class="campo-ayuda">Minimo 8 caracteres.</span>
    </div>

    <div class="campo">
      <label for="repetir">Repetir contrasena</label>
      <input type="password" id="repetir" name="repetir" required
             data-error="Las contrasenas no coinciden." data-igual-a="contrasena"
             autocomplete="new-password">
      <span class="campo-error" data-error-de="repetir"></span>
    </div>

    <button type="submit" class="boton boton-dorado boton-ancho">Crear cuenta</button>

    <p class="formulario-enlace">Ya tenes cuenta? <a href="/acceso">Ingresar</a>.</p>
    <p class="formulario-nota">Toda cuenta nueva se crea con el rol Lector. El Editor y el Administrador los asigna Kendry.</p>
  </form>
</section>

<%- include('parciales/pie') %>