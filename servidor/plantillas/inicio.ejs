<%- include('parciales/cabecera') %>

<section class="portada">
  <h1 class="portada-titulo">La memoria del mundo</h1>
  <p class="portada-bajada">
    Entheos es el continente conocido por los cronistas. Consulta continentes, lugares,
    personajes y objetos.
  </p>

  <form class="buscador-grande" action="/buscar" method="GET" role="search">
    <label class="solo-lectores" for="q-portada">Buscar artículos</label>
    <input type="search" id="q-portada" name="q" placeholder="Buscar artículos, lugares, personajes..."
           autocomplete="off" data-autocompletado>
    <ul class="sugerencias" data-sugerencias hidden></ul>
    <button type="submit" class="boton boton-dorado">Buscar</button>
  </form>
</section>

<section class="bloque">
  <h2 class="bloque-titulo">Explorar Contenido</h2>

  <div class="categorias">
    <% categorias.forEach(function (categoria) { %>
      <a class="categoria-banner" href="/articulos?categoria=<%= categoria.id %>">
        <span class="categoria-banner-marco">
          <% if (categoria.imagen_ruta) { %>
            <img class="categoria-banner-imagen" src="<%= categoria.imagen_ruta %>" alt="" loading="lazy">
          <% } %>
          <span class="categoria-banner-velo"></span>
        </span>
        <span class="categoria-banner-cont">
          <span class="categoria-banner-kicker"><%= categoria.articulos %> artículo<%= categoria.articulos === 1 ? '' : 's' %></span>
          <span class="categoria-banner-titulo"><%= categoria.nombre %></span>
          <span class="categoria-banner-cita">&ldquo;<%= categoria.descripcion %>&rdquo;</span>
        </span>
      </a>
    <% }); %>
  </div>
</section>

<section class="bloque">
  <h2 class="bloque-titulo">Últimos artículos</h2>

  <% if (recientes.length === 0) { %>
    <p class="vacio">Todavía no hay artículos publicados.</p>
  <% } else { %>
    <div class="rejilla">
      <% recientes.forEach(function (articulo) { %>
        <a class="tarjeta<%= articulo.categoria === 'Personajes' ? ' tarjeta--retrato' : '' %>" href="/articulos/<%= articulo.slug %>">
          <% if (articulo.imagen_ruta) { %>
            <img class="tarjeta-imagen" src="<%= articulo.imagen_ruta %>" alt="" loading="lazy">
          <% } %>
          <span class="tarjeta-cont">
            <span class="tarjeta-titulo"><%= articulo.titulo %></span>
            <span class="tarjeta-resumen"><%= articulo.resumen || 'Sin resumen.' %></span>
            <span class="tarjeta-pie">por <%= articulo.nombre_completo %></span>
          </span>
        </a>
      <% }); %>
    </div>
  <% } %>
</section>

<% if (!usuario) { %>
<section class="bloque">
  <div class="aviso">
    <h2 class="aviso-titulo">Regístrate para comentar</h2>
    <p class="aviso-texto">Con una cuenta podés dejar comentarios en los artículos. Toda cuenta nueva empieza con el rol Lector.</p>
    <a href="/registro" class="boton boton-dorado">Crear cuenta</a>
  </div>
</section>
<% } %>

<%- include('parciales/pie') %>