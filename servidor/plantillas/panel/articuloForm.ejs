<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
</head>
<body>
<%- include('../parciales/cabecera') %>
<%- include('_navegacion') %>

<%
  // Compara dos valores sin importar tildes ni mayúsculas, para marcar la opción
  // elegida en las listas de la ficha.
  function coincide(a, b) {
    const limpia = (v) => String(v === null || v === undefined ? '' : v)
      .trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    return limpia(a) === limpia(b);
  }
%>

<section class="hoja hoja-ancha">
  <h1 class="hoja-titulo"><%= articulo && articulo.id ? 'Editar artículo' : 'Nuevo artículo' %></h1>

  <% if (error) { %>
    <p class="alerta alerta-error"><%= error %></p>
  <% } %>

  <form class="formulario" action="/panel/articulos" method="POST" data-validar>

    <% if (articulo && articulo.id) { %>
      <input type="hidden" name="id" value="<%= articulo.id %>">
    <% } %>

    <div class="campo">
      <label for="categoria">Categoría</label>
      <select id="categoria" name="categoria_id" required>
        <option value="">Elegí una categoría</option>
        <% categorias.forEach(function (categoria) { %>
          <option value="<%= categoria.id %>" <%= articulo && articulo.categoria_id === categoria.id ? 'selected' : '' %>><%= categoria.nombre %></option>
        <% }); %>
      </select>
      <span class="campo-ayuda">Primero elegí la categoría: define los campos y las partes del artículo.</span>
    </div>

    <p class="campo-ayuda" id="sin-categoria">Elegí una categoría para ver los campos y las partes del artículo.</p>

    <div id="ficha-categoria" hidden>

      <div class="campo">
        <label for="titulo">Título</label>
        <input type="text" id="titulo" name="titulo" required minlength="3" maxlength="200"
               placeholder="Faro de la Casa Lumina"
               value="<%= articulo ? articulo.titulo || '' : '' %>"
               data-error="El título necesita al menos 3 caracteres.">
        <span class="campo-error" data-error-de="titulo"></span>
        <span class="campo-ayuda">Es libre: si no existe, se crea la localidad, región, reino o continente con ese nombre.</span>
      </div>

      <div class="campo">
        <label for="resumen">Resumen</label>
        <textarea id="resumen" name="resumen" rows="2" maxlength="500"
                  placeholder="En Portside, el viejo muelle cruje con cada marea y los pescadores cuentan que algo duerme bajo el agua."><%= articulo ? articulo.resumen || '' : '' %></textarea>
        <span class="campo-ayuda">Se muestra en el listado de artículos.</span>
      </div>

      <% categoriasForm.forEach(function (grupo) { %>
        <div class="grupo-categoria" data-grupo-categoria="<%= grupo.id %>" hidden>
          <h2 class="grupo-titulo"><%= grupo.nombre %></h2>

          <div class="grupo-ficha">
            <% grupo.campos.forEach(function (campo, indice) { %>
              <div class="campo">
                <label for="f-<%= grupo.id %>-<%= indice %>"><%= campo.etiqueta %></label>
                <% if (campo.tipo === 'lista') { %>
                  <select id="f-<%= grupo.id %>-<%= indice %>" name="f_<%= grupo.id %>_<%= indice %>">
                    <option value="">Sin especificar</option>
                    <% campo.opciones.forEach(function (opcion) { %>
                      <option value="<%= opcion %>" <%= coincide(campo.valor, opcion) ? 'selected' : '' %>><%= opcion %></option>
                    <% }); %>
                  </select>
                <% } else { %>
                  <input type="text" id="f-<%= grupo.id %>-<%= indice %>" name="f_<%= grupo.id %>_<%= indice %>" value="<%= campo.valor %>">
                <% } %>
              </div>
            <% }); %>

            <% grupo.extras.forEach(function (extra, indice) { %>
              <div class="campo">
                <label for="e-<%= grupo.id %>-<%= indice %>">Otro dato de la ficha</label>
                <div class="campo-doble">
                  <input type="text" id="e-<%= grupo.id %>-<%= indice %>" name="extra_etiqueta_<%= grupo.id %>" value="<%= extra.etiqueta %>" placeholder="Título" aria-label="Título del dato">
                  <input type="text" name="extra_valor_<%= grupo.id %>" value="<%= extra.valor %>" placeholder="Valor" aria-label="Valor del dato">
                </div>
              </div>
            <% }); %>
          </div>

          <div class="grupo-secciones">
            <% grupo.secciones.forEach(function (seccion) { %>
              <div class="campo">
                <label for="s-<%= grupo.id %>-<%= seccion.indice %>"><%= seccion.titulo %></label>
                <textarea id="s-<%= grupo.id %>-<%= seccion.indice %>" name="s_<%= grupo.id %>_<%= seccion.indice %>" rows="4" class="editor-memo"><%= seccion.valor %></textarea>
              </div>
            <% }); %>
          </div>

          <div class="campo">
            <label for="cuerpo-<%= grupo.id %>">Cuerpo libre (Markdown)</label>
            <textarea id="cuerpo-<%= grupo.id %>" name="cuerpo_<%= grupo.id %>" rows="10" class="editor-memo"><%= grupo.cuerpo %></textarea>
            <span class="campo-ayuda">
              Acá va la introducción y todo lo que no entra en las partes de arriba.
              Markdown: <code>## título</code>, <code>**negrita**</code>, <code>*cursiva*</code>,
              <code>- lista</code>, <code>> cita</code>, <code>[enlace](/ruta)</code>.
            </span>
          </div>
        </div>
      <% }); %>

      <div class="acciones-articulo">
        <button type="submit" class="boton boton-dorado" name="accion" value="borrador">Guardar como borrador</button>
        <button type="submit" class="boton boton-plano" name="accion" value="correccion">Enviar a corrección</button>
        <a href="/panel/articulos" class="boton boton-plano">Cancelar</a>
        <% if (articulo && articulo.estado === 'publicado') { %>
          <span class="campo-ayuda">Este artículo ya está publicado: «Guardar como borrador» lo devuelve a borrador.</span>
        <% } %>
      </div>
    </div>
  </form>

  <% if (articulo && articulo.id && esAdministrador) { %>
    <form action="/panel/articulos/<%= articulo.id %>/eliminar" method="POST"
          class="formulario-eliminar" data-confirmar="¿Eliminar este artículo? Esta acción no se puede deshacer.">
      <button type="submit" class="boton boton-peligro">Eliminar artículo</button>
    </form>
  <% } %>
</section>

<%- include('../parciales/pie') %>
