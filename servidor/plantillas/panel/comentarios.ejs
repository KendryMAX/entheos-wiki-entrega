<%- include('../parciales/cabecera') %>

<section class="bloque">
  <div class="bloque-cabecera">
    <h1 class="bloque-titulo">Moderacion de comentarios</h1>
    <div class="filtros">
      <span class="conteo">Pendientes: <%= comentarios.filter(function (c) { return c.estado === 'pendiente'; }).length %></span>
    </div>
  </div>

  <% if (comentarios.length === 0) { %>
    <p class="vacio">No hay comentarios para moderar.</p>
  <% } else { %>
    <ul class="lista-comentarios">
      <% comentarios.forEach(function (comentario) { %>
        <li class="comentario-mod">
          <p class="comentario-cabecera">
            <strong><%= comentario.nombre_usuario %></strong>
            en <a href="/articulos/<%= comentario.slug %>"><%= comentario.titulo %></a>
            &middot; <%= new Date(comentario.creado_en).toLocaleString('es-AR') %>
            &middot; <span class="estado estado-<%= comentario.estado %>"><%= comentario.estado %></span>
          </p>
          <p class="comentario-texto"><%= comentario.contenido %></p>

          <% if (comentario.estado === 'pendiente') { %>
            <div class="comentario-acciones">
              <form action="/panel/comentarios/<%= comentario.id %>" method="POST" class="formulario-en-linea">
                <input type="hidden" name="decision" value="aprobar">
                <button type="submit" class="boton boton-dorado boton-chico">Aprobar</button>
              </form>
              <form action="/panel/comentarios/<%= comentario.id %>" method="POST" class="formulario-en-linea">
                <input type="hidden" name="decision" value="rechazar">
                <button type="submit" class="boton boton-plano boton-chico">Rechazar</button>
              </form>
            </div>
          <% } %>
        </li>
      <% }); %>
    </ul>
  <% } %>
</section>

<%- include('../parciales/pie') %>